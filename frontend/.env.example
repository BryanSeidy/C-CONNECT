# C-Connect frontend environment template

# Public URL of the Laravel API without trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Feature flags. Keep risky modules disabled until their backend contracts pass
# staging smoke tests.
NEXT_PUBLIC_FEATURE_RFQ=true
NEXT_PUBLIC_FEATURE_RECURRING=false
NEXT_PUBLIC_FEATURE_NEGOTIATIONS=false
NEXT_PUBLIC_FEATURE_GAMIFICATION=false
NEXT_PUBLIC_FEATURE_REVIEWS=false
