# =============================================================================
# C-Connect — Laravel Backend .env template
# Copie ce fichier en .env et remplis les valeurs marquées <CHANGE_ME>
# =============================================================================

APP_NAME="C-Connect"
APP_ENV=local
APP_KEY=<CHANGE_ME: php artisan key:generate>
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# URL du frontend Next.js — utilisée pour les liens emailés (reset password,
# vérification email) qui doivent pointer vers la SPA, pas vers l'API.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cconnect
DB_USERNAME=<CHANGE_ME>
DB_PASSWORD=<CHANGE_ME>

# ---------------------------------------------------------------------------
# Session — Laravel l'utilise en interne (routes web.php, flash messages) ;
# l'authentification API elle-même est un Bearer token (Sanctum personal
# access token), pas la session/cookie — voir config/sanctum.php.
# ---------------------------------------------------------------------------
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Cache / Queue
# ---------------------------------------------------------------------------
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Mail (désactivé en local)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@c-connect.cm"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Database failover / offline demo mode
# ---------------------------------------------------------------------------
# Production/staging default must remain false. Set true only for a deliberate
# local offline demo that is allowed to fall back to database/local_backup.sqlite.
DB_FAILOVER_ENABLED=false
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Payment webhooks / Mobile Money
# ---------------------------------------------------------------------------
CCONNECT_WEBHOOK_SECRET=<CHANGE_ME_RANDOM_64_BYTES>
MOBILE_MONEY_PROVIDER=simulation
CAMPAY_BASE_URL=
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_SECRET=
NOTCHPAY_BASE_URL=
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_SECRET_KEY=
NOTCHPAY_WEBHOOK_SECRET=
MONBILLET_BASE_URL=
MONBILLET_API_KEY=
MONBILLET_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# OAuth providers
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/social/google/callback

# ---------------------------------------------------------------------------
# Production hardening reminders
# ---------------------------------------------------------------------------
TRUSTED_PROXIES=*
SANCTUM_STATEFUL_DOMAINS=localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
