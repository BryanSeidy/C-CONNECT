# ==============================================================================
# C-Connect — .htaccess racine (Hostinger Business / Hébergement mutualisé)
# ==============================================================================
#
# Sur un hébergement mutualisé, le DocumentRoot pointe sur la racine du projet
# Laravel, PAS sur le sous-dossier public/. Ce fichier redirige proprement
# tout le trafic web vers public/index.php sans exposer les fichiers sensibles
# (.env, composer.json, storage/, etc.).
#
# PLACEMENT : backend/.htaccess (racine du projet Laravel déployé)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # -------------------------------------------------------------------------
    # 1. Forcer HTTPS en production (Hostinger fournit un SSL gratuit)
    # -------------------------------------------------------------------------
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # -------------------------------------------------------------------------
    # 2. Préserver le header Authorization (souvent strippé par Apache CGI)
    #    Critique pour l'authentification Bearer Token (Sanctum).
    # -------------------------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # -------------------------------------------------------------------------
    # 3. Rediriger TOUT le trafic vers public/index.php
    #    Si le fichier/dossier demandé n'existe pas dans public/, on passe
    #    par le front controller Laravel.
    # -------------------------------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# ==============================================================================
# Sécurité : Bloquer l'accès direct aux fichiers sensibles
# ==============================================================================

# Bloquer l'accès à .env, .git, composer.*, etc.
<FilesMatch "^\.env|^\.git|composer\.(json|lock)$|artisan$|phpunit\.xml$|\.editorconfig$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquer l'accès aux répertoires sensibles
<IfModule mod_rewrite.c>
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L]
</IfModule>

# ==============================================================================
# Performance : Compression & Cache (optionnel mais recommandé)
# ==============================================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

<IfModule mod_headers.c>
    # Empêcher le MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    # Protection XSS basique
    Header set X-XSS-Protection "1; mode=block"
    # Empêcher le clickjacking
    Header set X-Frame-Options "DENY"
    # Referrer strict
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
